---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Lux — AI automation for businesses. Save time and money by automating your operations with AI." />
    <title>Lux — AI Automation Agency</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Cal.com embed -->
    <script src="https://cal.eu/embed/embed.js" async></script>
  </head>
  <body class="bg-lux-50 text-lux-900 font-sans antialiased">

    <!-- Nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-lux-50/80 backdrop-blur-md border-b border-lux-200/50">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-2xl font-semibold tracking-tight">Lux</a>
        <div class="hidden md:flex items-center gap-8 text-sm text-lux-600">
          <a href="#services" class="hover:text-lux-900 transition-colors">Services</a>
          <a href="#pricing" class="hover:text-lux-900 transition-colors">Pricing</a>
          <a href="#contact" class="hover:text-lux-900 transition-colors">Contact</a>
        </div>
        <a href="#contact" class="text-sm font-medium px-5 py-2.5 bg-lux-900 text-lux-50 rounded-lg hover:bg-lux-800 transition-colors">
          Get Started
        </a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="pt-40 pb-24 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-semibold tracking-tight leading-[1.1] mb-6">
          Automate your business<br />with AI
        </h1>
        <p class="text-lg md:text-xl text-lux-500 max-w-xl mx-auto mb-10 leading-relaxed">
          We handle the AI so you can focus on growth. From content to customer support, Lux automates the work that slows you down.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#contact" class="px-8 py-3.5 bg-lux-900 text-lux-50 rounded-lg font-medium hover:bg-lux-800 transition-colors text-base">
            Join the Waitlist
          </a>
          <a href="#services" class="px-8 py-3.5 border border-lux-300 text-lux-700 rounded-lg font-medium hover:border-lux-400 transition-colors text-base">
            See What We Do
          </a>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3">Services</p>
          <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">What we automate</h2>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Build -->
          <div class="bg-white rounded-2xl p-8 border border-lux-200/80">
            <div class="w-10 h-10 bg-lux-100 rounded-lg flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-lux-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Build</h3>
            <p class="text-lux-500 mb-4">Custom digital products, built fast.</p>
            <ul class="space-y-2 text-sm text-lux-600">
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Websites</li>
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Apps</li>
            </ul>
          </div>

          <!-- Create -->
          <div class="bg-white rounded-2xl p-8 border border-lux-200/80">
            <div class="w-10 h-10 bg-lux-100 rounded-lg flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-lux-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Create</h3>
            <p class="text-lux-500 mb-4">AI-powered content at scale.</p>
            <ul class="space-y-2 text-sm text-lux-600">
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Content generation</li>
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Multilingual content</li>
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Batch design generation</li>
            </ul>
          </div>

          <!-- Market -->
          <div class="bg-white rounded-2xl p-8 border border-lux-200/80">
            <div class="w-10 h-10 bg-lux-100 rounded-lg flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-lux-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Market</h3>
            <p class="text-lux-500 mb-4">Find customers and grow revenue on autopilot.</p>
            <ul class="space-y-2 text-sm text-lux-600">
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Market research</li>
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Lead generation</li>
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Customer reactivation</li>
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Ad management</li>
            </ul>
          </div>

          <!-- Support -->
          <div class="bg-white rounded-2xl p-8 border border-lux-200/80">
            <div class="w-10 h-10 bg-lux-100 rounded-lg flex items-center justify-center mb-5">
              <svg class="w-5 h-5 text-lux-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Support</h3>
            <p class="text-lux-500 mb-4">Never miss a customer message again.</p>
            <ul class="space-y-2 text-sm text-lux-600">
              <li class="flex items-center gap-2"><span class="w-1 h-1 bg-lux-400 rounded-full"></span>Email support automation</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="py-24 px-6 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <p class="text-sm font-medium text-accent uppercase tracking-widest mb-3">Pricing</p>
          <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">Simple, transparent pricing</h2>
          <p class="text-lux-500 mt-4 max-w-lg mx-auto">Pick the plan that fits your business. Scale up anytime.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <!-- Starter -->
          <div class="rounded-2xl border border-lux-200/80 p-8 bg-lux-50">
            <h3 class="text-lg font-semibold mb-1">Starter</h3>
            <p class="text-sm text-lux-500 mb-6">For small teams getting started with AI.</p>
            <div class="mb-6">
              <span class="text-4xl font-semibold">$2,000</span>
              <span class="text-lux-500 text-sm">/month</span>
            </div>
            <ul class="space-y-3 text-sm text-lux-600 mb-8">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                1 automation workflow
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Basic content generation
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Email support
              </li>
            </ul>
            <a href="#contact" class="block text-center py-3 px-6 border border-lux-300 rounded-lg text-sm font-medium hover:border-lux-400 transition-colors">
              Get Started
            </a>
          </div>

          <!-- Growth -->
          <div class="rounded-2xl border-2 border-lux-900 p-8 bg-lux-50 relative">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 bg-lux-900 text-lux-50 text-xs font-medium rounded-full">
              Most Popular
            </div>
            <h3 class="text-lg font-semibold mb-1">Growth</h3>
            <p class="text-sm text-lux-500 mb-6">For businesses ready to scale operations.</p>
            <div class="mb-6">
              <span class="text-4xl font-semibold">$5,000</span>
              <span class="text-lux-500 text-sm">/month</span>
            </div>
            <ul class="space-y-3 text-sm text-lux-600 mb-8">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-900 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Up to 5 automation workflows
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-900 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Content + multilingual support
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-900 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Lead generation & outreach
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-900 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Priority support
              </li>
            </ul>
            <a href="#contact" class="block text-center py-3 px-6 bg-lux-900 text-lux-50 rounded-lg text-sm font-medium hover:bg-lux-800 transition-colors">
              Get Started
            </a>
          </div>

          <!-- Enterprise -->
          <div class="rounded-2xl border border-lux-200/80 p-8 bg-lux-50">
            <h3 class="text-lg font-semibold mb-1">Enterprise</h3>
            <p class="text-sm text-lux-500 mb-6">Full-service AI transformation.</p>
            <div class="mb-6">
              <span class="text-4xl font-semibold">Custom</span>
            </div>
            <ul class="space-y-3 text-sm text-lux-600 mb-8">
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Unlimited workflows
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Custom integrations
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                Dedicated account manager
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-lux-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                SLA guarantees
              </li>
            </ul>
            <a href="#contact" class="block text-center py-3 px-6 border border-lux-300 rounded-lg text-sm font-medium hover:border-lux-400 transition-colors">
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Proof -->
    <section class="py-24 px-6">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-sm font-medium text-accent uppercase tracking-widest mb-12">Built for businesses like yours</p>
        <div class="grid md:grid-cols-3 gap-12">
          <div>
            <div class="text-4xl font-semibold mb-2">10x</div>
            <p class="text-sm text-lux-500">Faster content production</p>
          </div>
          <div>
            <div class="text-4xl font-semibold mb-2">80%</div>
            <p class="text-sm text-lux-500">Reduction in manual tasks</p>
          </div>
          <div>
            <div class="text-4xl font-semibold mb-2">24/7</div>
            <p class="text-sm text-lux-500">Automated customer support</p>
          </div>
        </div>
        <div class="mt-16 pt-16 border-t border-lux-200">
          <p class="text-lux-400 text-sm italic">
            "We're building Lux to be the AI partner every growing business deserves. Testimonials coming soon as we onboard our first clients."
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact" class="py-24 px-6 bg-lux-900 text-lux-50">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight mb-4">Ready to automate?</h2>
        <p class="text-lux-400 mb-10 text-lg">Join the waitlist and be the first to know when we launch. Or book a call to discuss your needs.</p>

        <!-- Email Capture (Formsubmit.co — forwards to configured email) -->
        <form id="waitlist-form" action="https://formsubmit.co/ajax/hello@getlux.ai" method="POST" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-6">
          <input type="hidden" name="_subject" value="New Lux Waitlist Signup" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" style="display:none" />
          <label for="waitlist-email" class="sr-only">Email address</label>
          <input
            type="email"
            id="waitlist-email"
            name="email"
            placeholder="you@company.com"
            required
            aria-required="true"
            class="flex-1 px-4 py-3 rounded-lg bg-lux-800 border border-lux-700 text-lux-50 placeholder:text-lux-500 focus:outline-none focus:border-lux-500 text-sm"
          />
          <button type="submit" id="waitlist-btn" class="px-6 py-3 bg-white text-lux-900 rounded-lg font-medium text-sm hover:bg-lux-100 transition-colors whitespace-nowrap">
            Join Waitlist
          </button>
        </form>
        <p id="form-success" class="text-accent-light text-sm hidden">Thanks! We'll be in touch soon.</p>
        <p id="form-error" class="text-red-400 text-sm hidden">Something went wrong. Please try again.</p>

        <div class="flex items-center gap-4 justify-center my-8">
          <div class="h-px bg-lux-700 w-16"></div>
          <span class="text-lux-500 text-sm">or</span>
          <div class="h-px bg-lux-700 w-16"></div>
        </div>

        <button
          data-cal-link="xenterprises/discovery-call"
          data-cal-origin="https://cal.eu"
          data-cal-config='{"layout":"month_view","theme":"dark"}'
          class="inline-block px-8 py-3.5 border border-lux-600 text-lux-200 rounded-lg font-medium text-sm hover:border-lux-400 transition-colors cursor-pointer bg-transparent"
        >
          Book a Discovery Call
        </button>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-12 px-6 border-t border-lux-200">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-lg font-semibold tracking-tight">Lux</div>
        <div class="flex items-center gap-6 text-sm text-lux-500">
          <a href="#services" class="hover:text-lux-900 transition-colors">Services</a>
          <a href="#pricing" class="hover:text-lux-900 transition-colors">Pricing</a>
          <a href="#contact" class="hover:text-lux-900 transition-colors">Contact</a>
        </div>
        <p class="text-sm text-lux-400">&copy; 2026 Lux. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
      const success = document.getElementById('form-success');
      const error = document.getElementById('form-error');
      const btn = document.getElementById('waitlist-btn') as HTMLButtonElement | null;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        error?.classList.add('hidden');
        if (btn) { btn.disabled = true; btn.textContent = 'Submitting...'; }

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(form))),
          });
          if (!res.ok) throw new Error('Network error');
          form.reset();
          form.classList.add('hidden');
          success?.classList.remove('hidden');
        } catch {
          error?.classList.remove('hidden');
          if (btn) { btn.disabled = false; btn.textContent = 'Join Waitlist'; }
        }
      });
    </script>

  </body>
</html>
